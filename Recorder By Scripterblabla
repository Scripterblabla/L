local setClipboard, writeFile, makeFolder, isFolder
do
	local function envFn(...)
		local names = { ... }
		local function lookup(getEnv)
			local ok, env = pcall(getEnv)
			if ok and type(env) == "table" then
				for _, n in ipairs(names) do
					local ok2, f = pcall(function() return env[n] end)
					if ok2 and type(f) == "function" then return f end
				end
			end
			return nil
		end
		return lookup(function() return getgenv() end) or lookup(getfenv)
	end

	setClipboard = envFn("setclipboard", "toclipboard", "set_clipboard", "writeclipboard")
		or (type(setclipboard) == "function" and setclipboard)
		or (type(toclipboard) == "function" and toclipboard) or nil
