	local function buildAnimationJson(sessionName, length)
		local head = {
			name = sessionName, length = rnd(length), rig = "R6", priority = "Action", loop = true,
			note = "poses = Motor6D Transform per joint (CFrame components). rootMotion = HumanoidRootPart relative to its start pose.",
		}
		local framesJson = encodeArray(frames, 100, function(f)
			local poses = {}
			for name, cf in pairs(f.poses) do poses[name] = cfArr(cf) end
			return { t = rnd(f.t), poses = poses }
		end)
		local rootJson = encodeArray(frames, 150, function(f) return { t = rnd(f.t), cf = cfArr(f.root) } end)
		return jsonWithArrays(head, { { "frames", framesJson }, { "rootMotion", rootJson } })
