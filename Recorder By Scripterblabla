				local parts = {}
				for _, name in ipairs(JOINT_NAMES) do
					local cf = f.poses[name]
					if cf then
						local key = name:find(" ", 1, true) and ('["' .. name .. '"]') or name
						table.insert(parts, key .. "=" .. cfCode(cf))
					end
				end
				add(("K(%s, { %s })"):format(numStr(f.t - t0), table.concat(parts, ", ")))
			end
			add("ks.Parent = workspace")
			return table.concat(lines, "\n")
		end

		local count = #order
		local code = render(count)
		while #code > CONFIG.CopyLimit and count > 4 do
			count = math.max(4, math.floor(count * 0.85))
			code = render(count)
			slice()
		end
		return code
	end

	local function buildQuickList(sessionName, length)
		local buf = newBuf()
		local add = buf.add

		add(("===== VFX QUICK LIST - %s - %.3fs - %d effects, %d models ====="):format(sessionName, length, #vfxList, #modelList))
		if #vfxList == 0 then add("(no VFX detected)") end
		for _, rec in ipairs(vfxList) do
			local endT = rec.removed or length
			add(("#%d %s \"%s\" [%s] on %s"):format(rec.id, rec.class, rec.name, rec.category, rec.host.label))
			add(("   time: %.3fs -> %.3fs%s"):format(rec.start, endT, rec.removed and "" or " (until end)"))
			local ev = {}
			for _, e in ipairs(rec.events) do
				table.insert(ev, ("%s %.3f"):format(e.kind, e.t))
			end
			add("   events: " .. table.concat(ev, " | "))
			if #rec.emits > 0 then add(("   emit calls: %d"):format(#rec.emits)) end
			if #rec.assetIds > 0 then add("   assets: " .. table.concat(rec.assetIds, ", ")) end
		end

		if #modelList > 0 then
			add("")
			add(("MODELS / WORLD MODELS / SPAWNED PARTS (%d) - clones in Dex > Models, data in models.json:"):format(#modelList))
			for _, rec in ipairs(modelList) do
				add(("M#%d %s \"%s\" parts=%d"):format(rec.id, rec.class, rec.name, rec.partCount))
				add(("   time: %.3fs -> %.3fs%s"):format(rec.start, rec.removed or length, rec.removed and "" or " (until end)"))
				if #rec.assetIds > 0 then add("   assets: " .. table.concat(rec.assetIds, ", ")) end
			end
		end

		add("")
		add((REC.victim and "VICTIM" or "PLAYER") .. " ANIMATION: KeyframeSequence code is in keyframe_sequence.lua (also in the full copy below).")
		if #animEvents > 0 then
			add("Game animation tracks that were playing (names/times only):")
			for _, ev in ipairs(animEvents) do
				add(("   %.3fs -> %.3fs  \"%s\""):format(ev.start, ev.stop or length, ev.name))
			end
		end

		if #camSamples > 0 then
			local minFov, maxFov = math.huge, -math.huge
			for _, s in ipairs(camSamples) do
				minFov, maxFov = math.min(minFov, s.fov), math.max(maxFov, s.fov)
			end
			add("")
			add(("CAMERA: %d samples, FOV %.1f-%.1f, saved in camera.json / Camera folder"):format(#camSamples, minFov, maxFov))
		end
		return buf.text()
	end

	local function saveToDisk(sessionName, files, latestFiles)
		if not (CONFIG.SaveToDisk and writeFile and makeFolder) then return false, nil, {} end
		local base = CONFIG.FolderName .. "/" .. sessionName
		local function mk(path)
			if isFolder then
				local ok, exists = pcall(isFolder, path)
				if ok and exists then return end
			end
			pcall(makeFolder, path)
		end
		mk(CONFIG.FolderName)
		mk(base)
		local failed = {}
		for name, data in pairs(files) do
			local ok = pcall(writeFile, base .. "/" .. name, data)
			if not ok then table.insert(failed, name) end
			slice()
		end
		for name, data in pairs(latestFiles or {}) do
			local ok = pcall(writeFile, CONFIG.FolderName .. "/" .. name, data)
			if not ok then table.insert(failed, name) end
			slice()
		end
		return #failed == 0, base, failed
	end

	local function pruneSessions(rootFolder)
		local list = {}
		for _, c in ipairs(rootFolder:GetChildren()) do
			if c:IsA("Folder") then list[#list + 1] = c end
		end
		table.sort(list, function(a, b) return (a:GetAttribute("Created") or 0) < (b:GetAttribute("Created") or 0) end)
		while #list >= math.max(CONFIG.KeepSessions, 1) do
			local oldest = table.remove(list, 1)
			pcall(function() oldest:Destroy() end)
		end
	end

	local function stage(frac, text)
		setProgress(frac)
		if text then setStatus(text, THEME.ok, true) end
		task.wait()
		resetSlice()
	end

	local function buildKeyframeSequence(sessionName, onProgress)
		local ks = Instance.new("KeyframeSequence")
		ks.Name = sessionName
		ks.Loop = true
		ks.Priority = Enum.AnimationPriority.Action
		ks.Archivable = true

		local function newPose(name, cf)
			local p = Instance.new("Pose")
			p.Name = name
			p.CFrame = cf
			p.Weight = 1
			return p
		end

		local n = #frames
		for i = 1, n do
			local f = frames[i]
			local kf = Instance.new("Keyframe")
			kf.Time = f.t
			local rootPose = newPose("HumanoidRootPart", CFrame.new())
			local torsoPose = newPose("Torso", f.poses.Torso or CFrame.new())
			torsoPose.Parent = rootPose
			for _, data in ipairs(JOINTS) do
				local cf = f.poses[data.partName]
				if cf then
					local pose = newPose(data.partName, cf)
					pose.EasingStyle = Enum.PoseEasingStyle.Linear
					pose.EasingDirection = Enum.PoseEasingDirection.Out
					pose.Parent = torsoPose
				end
			end
			rootPose.Parent = kf
			kf.Parent = ks
			if i % 25 == 0 then
				slice()
				if onProgress then onProgress(i / n) end
			end
		end
		return ks
	end

	function X.finalize(length)
		resetSlice()
		local sessionName = REC.prefix .. os.date("%H%M%S")
		local camEnd = cameraMeta()
		local nFrames, nCam, nVfx, nModels = #frames, #camSamples, #vfxList, #modelList

		for track, ev in pairs(activeTracks) do
			ev.stop = ev.stop or length
			activeTracks[track] = nil
		end

		stage(0.04, "Building KeyframeSequence...")
		local ks = buildKeyframeSequence(sessionName, function(f) setProgress(0.04 + 0.26 * f) end)

		stage(0.32, "Creating Dex folders...")
		local rootFolder = ReplicatedStorage:FindFirstChild(CONFIG.DexFolderName)
		if not rootFolder then
			rootFolder = Instance.new("Folder")
			rootFolder.Name = CONFIG.DexFolderName
			rootFolder.Parent = ReplicatedStorage
		end
		pruneSessions(rootFolder)
		local session = Instance.new("Folder")
		session.Name = sessionName
		setAttr(session, "Created", os.time())
		session.Parent = rootFolder
		ks.Parent = session
		local vfxFolder = Instance.new("Folder")
		vfxFolder.Name = "VFX"
		vfxFolder.Parent = session
		local modelFolder = Instance.new("Folder")
		modelFolder.Name = "Models"
		modelFolder.Parent = session
		local camFolder = Instance.new("Folder")
		camFolder.Name = "Camera"
		camFolder.Parent = session
		local reportFolder = Instance.new("Folder")
		reportFolder.Name = "Report"
		reportFolder.Parent = session

		for i, rec in ipairs(vfxList) do
			local c = rec.clone
			if c then
				setAttr(c, "StartTime", rnd(rec.start))
				setAttr(c, "EndTime", rnd(rec.removed or length))
				setAttr(c, "StillActiveAtEnd", rec.removed == nil)
				setAttr(c, "Category", rec.category)
				setAttr(c, "Origin", rec.origin)
				setAttr(c, "HostPart", rec.host.part or "")
				setAttr(c, "HostAttachment", rec.host.attachment or "")
				setAttr(c, "OriginalPath", rec.path)
				setAttr(c, "RecorderId", rec.id)
				setAttr(c, "OriginalName", rec.name)
				setAttr(c, "InitialEnabled", rec.props.Enabled)
				setAttr(c, "EventsJson", fitAttrJson(rec.events, 60000))
				if #rec.emits > 0 then
					local list = {}
					for k, e in ipairs(rec.emits) do
						if k > 1500 then break end
						list[k] = { rnd(e.t), e.n }
					end
					setAttr(c, "EmitsJson", fitAttrJson(list, 60000))
				end
				if rec.hostAttCF then setAttr(c, "HostAttachmentCFrame", rec.hostAttCF) end
				if rec.hostRel then setAttr(c, "HostRelToRoot", rec.hostRel) end
				if rec.hostModelId then setAttr(c, "HostModelId", rec.hostModelId) end
				if rec.relCF then
					setAttr(c, "RelPosToRoot", rec.relCF.Position)
					local rx, ry, rz = rec.relCF:ToOrientation()
					setAttr(c, "RelRotToRootDeg", Vector3.new(math.deg(rx), math.deg(ry), math.deg(rz)))
				end
				c.Parent = vfxFolder
			end
			if i % 5 == 0 then slice() end
		end

		for i, rec in ipairs(modelList) do
			local c = rec.clone
			if c then
				setAttr(c, "StartTime", rnd(rec.start))
				setAttr(c, "EndTime", rnd(rec.removed or length))
				setAttr(c, "StillActiveAtEnd", rec.removed == nil)
				setAttr(c, "Origin", rec.origin)
				setAttr(c, "OriginalPath", rec.path)
				setAttr(c, "OriginalName", rec.name)
				setAttr(c, "OriginalClass", rec.class)
				setAttr(c, "RecorderId", rec.id)
				setAttr(c, "PartCount", rec.partCount)
				setAttr(c, "ReferencePart", table.concat(rec.refPath, "/"))
				setAttr(c, "RelCFrameStart", rec.rel0)
				setAttr(c, "EventsJson", fitAttrJson(rec.events, 60000))
				c.Parent = modelFolder
			end
			if i % 5 == 0 then slice() end
		end

		stage(0.38, "Reducing keyframes + building code...")
		local animCode = buildKeyframeCode(sessionName)
		stage(0.5, "Building VFX list...")
		local quickList = buildQuickList(sessionName, length)
		stage(0.56, "Scanning related scripts...")
		local depLines = scanDependencies(rootFolder)
		stage(0.62, "Building full report...")
		local detail = buildReport(sessionName, length, camEnd, depLines)
		local allText = quickList .. "\n\n===== " .. (REC.victim and "VICTIM" or "PLAYER") .. " ANIMATION - KEYFRAMESEQUENCE CODE (paste into Studio) =====\n"
			.. animCode .. "\n\n" .. detail

		local copyList = (fitText(quickList, CONFIG.CopyLimit))
		local copyAnim = animCode
		local copyAll = (fitText(allText, CONFIG.CopyAllLimit))

		stage(0.68, "Encoding VFX data...")
		local vfxJson = buildVFXJson()
		stage(0.73, "Encoding model data...")
		local modelJson = buildModelsJson()
		stage(0.78, "Encoding camera data...")
		local camJson = buildCameraJson(length)
		stage(0.84, "Encoding animation data...")
		local animJson = buildAnimationJson(sessionName, length)

		stage(0.9, "Saving to Dex...")
		storeLongString(session, "VFX_List", (fitText(quickList, CONFIG.DexStringLimit)))
		storeLongString(session, "KeyframeSequence_Code", copyAnim)
		storeLongString(reportFolder, "Report", (fitText(allText, CONFIG.DexStringLimit)))
		storeLongString(reportFolder, "VFXData", dexJson(vfxJson, "vfx.json"))
		storeLongString(reportFolder, "ModelData", dexJson(modelJson, "models.json"))
		storeLongString(camFolder, "CameraData", dexJson(camJson, "camera.json"))
		setAttr(camFolder, "Samples", nCam)
		setAttr(camFolder, "Length", rnd(length))

		stage(0.95, "Copying + writing files...")
		local copied = false
		if CONFIG.AutoClipboard and setClipboard then
			copied = pcall(setClipboard, copyAll) == true
		end

		local savedOk, diskPath, failed = saveToDisk(sessionName, {
			["vfx_list.txt"] = quickList, ["keyframe_sequence.lua"] = animCode, ["report.txt"] = allText,
			["vfx.json"] = vfxJson, ["models.json"] = modelJson, ["camera.json"] = camJson, ["animation.json"] = animJson,
		}, {
			["latest_vfx_list.txt"] = quickList, ["latest_keyframe_sequence.lua"] = animCode, ["latest_report.txt"] = allText,
		})

		lastReport = copyAll
		lastList = copyList
		lastAnimCode = copyAnim
		lastSession = {
			ks = ks, cam = camSamples, name = sessionName, length = length, noFrames = nFrames == 0,
			vfx = VR.snapshot(length), models = VR.snapshotModels(length),
		}

		frames = {}
		vfxList, vfxByInst, partRecs, fxRecs, watchRecs = {}, {}, {}, {}, {}
		modelList, modelByInst = {}, {}
		assets, assetOrder, scriptsFound = {}, {}, {}
		qReset()

		setReport(copyAll)
		setReportOpen(true)
		setStats(length, nFrames, nCam, nVfx, nModels)

		local diskLine
		if not (writeFile and makeFolder) then
			diskLine = "Disk: no writefile here - use the Dex folder or the clipboard."
		elseif savedOk then
			diskLine = "Disk: workspace/" .. diskPath .. "/ (7 files, full size)"
		else
			diskLine = "Disk: workspace/" .. diskPath .. "/ but these failed: " .. table.concat(failed, ", ")
		end
		local parts = {
			("Saved %s: %d VFX, %d models, %d cam, %d frames."):format(sessionName, nVfx, nModels, nCam, nFrames),
			"Dex: ReplicatedStorage > " .. CONFIG.DexFolderName .. " > " .. sessionName,
			diskLine,
			copied and ("Copied to clipboard (%s chars)."):format(formatNum(#copyAll)) or "No clipboard API - use the viewer.",
		}
		stage(1, table.concat(parts, "\n"))
		notify(copied and "Saved - report copied to clipboard" or "Saved - see Dex / disk folder", "ok")
		task.delay(0.9, function() setProgress(nil) end)
	end

	return X
end)()

local function setRecordingUI(isRecording)
	recBtn.setText(isRecording and "STOP RECORDING" or "START RECORDING")
	recBtn.setColor(isRecording and THEME.go or THEME.rec)
	setPulse(isRecording)
	recTimer.Text = isRecording and "00:00.0" or ""
	if not isRecording then setSubtitle("v9 - ready") end
end

function startRecording()
	if finalizing then
		notify("Still saving the last recording...", "warn")
		return
	end
	if humanoid.RigType ~= Enum.HumanoidRigType.R6 then
		notify("This tool only supports R6 characters.", "err")
		setStatus("This tool only supports R6 characters.", THEME.warn)
		return
	end
	local root = getRoot()
	if not root or not character:FindFirstChild("Torso") then
		notify("Character is missing HumanoidRootPart/Torso.", "err")
		return
	end

	local modeKey = UI.getMode()
	local spec = MODES[modeKey] or MODES.full
	local victim = nil
	if modeKey == "victim" then
		local nameText = UI.getVictim()
		if nameText == "" then
			notify("Type the victim name or username first.", "warn")
			setStatus("Victim mode: type the victim name / username in the box next to the mode button.", THEME.warn)
			return
		end
		local found, err = MODES.find(nameText)
		if not found then
			notify(err, "err")
			setStatus(err, THEME.warn)
			return
		end
		victim = found
	end
	REC.pose, REC.cam, REC.vfx, REC.models = spec.pose, spec.cam, spec.vfx, spec.models
	REC.tracks = spec.pose and victim == nil
	REC.target = victim
	REC.mode, REC.label, REC.prefix = modeKey, spec.label, spec.prefix
	REC.victim = victim and victim.Name or nil

	PB.stopCamera()
	PB.stopVFX()
	if testClone then
		testClone:Destroy()
		testClone = nil
	end

	frames, camSamples = {}, {}
	frameStride, frameCounter, camStride, camCounter = 1, 0, 1, 0
	vfxList, vfxByInst, partRecs, fxRecs, watchRecs = {}, {}, {}, {}, {}
	modelList, modelByInst = {}, {}
	effectPartCount, cloneCount, capNotified = 0, 0, false
	assets, assetOrder = {}, {}
	animEvents, activeTracks = {}, {}
	scriptsFound = {}
	recent = {}
	qReset()
	CAP.reset()
	if REC.vfx then CAP.startHooks() else CAP.emitHook = false end
	camStart = cameraMeta()
	startRootCF = (victim and victim:FindFirstChild("HumanoidRootPart") or root).CFrame
	startClock = os.clock()
	recording = true
	setRecordingUI(true)
	setActionsEnabled(false, lastReport ~= nil)
	setStats(0, 0, 0, 0, 0)

	if REC.vfx then
		for _, inst in ipairs(character:GetDescendants()) do
			if CLASS_CATEGORY[inst.ClassName] and CAP.shouldTrack(inst, root) then CAP.register(inst, 0, true) end
		end
		for _, container in ipairs({ Lighting, Workspace.CurrentCamera }) do
			if container then
				for _, inst in ipairs(container:GetChildren()) do
					if CLASS_CATEGORY[inst.ClassName] == "PostFX" and CAP.shouldTrack(inst, root) then CAP.register(inst, 0, true) end
				end
			end
		end
	end

	local okScan, errScan = pcall(CAP.scanPresentModels, root)

	if REC.vfx or REC.models then
		table.insert(conns, Workspace.DescendantAdded:Connect(CAP.onAdded))
		table.insert(conns, Lighting.DescendantAdded:Connect(CAP.onAdded))
		table.insert(conns, SoundService.DescendantAdded:Connect(CAP.onAdded))
	end
	table.insert(conns, RunService.Heartbeat:Connect(CAP.recordFrame))
	if REC.cam then table.insert(conns, RunService.RenderStepped:Connect(CAP.recordCamera)) end
	table.insert(conns, humanoid.Died:Connect(function() stopRecording() end))

	refreshHud(true)
end

function stopRecording()
	if not recording then return end
	local length = now()
	recording = false
	for _, c in ipairs(conns) do c:Disconnect() end
	table.clear(conns)
	setRecordingUI(false)

	if (REC.pose and #frames < 5) or (not REC.pose and length < 0.3) then
		notify("Record longer! (need at least a few frames)", "warn")
		setStatus("Record longer! (need at least a few frames)", THEME.warn)
		setActionsEnabled(lastSession ~= nil, true)
		return
	end

	finalizing = true
	setActionsEnabled(false, false)
	recBtn.setEnabled(false)
	recBtn.setText("PROCESSING...")
	setSubtitle("Processing...", THEME.accent)
	setStatus("Building report...")
	setProgress(0.02)
	task.spawn(function()
		local ok, err = xpcall(EX.finalize, debug.traceback, length)
		if not ok then
			setStatus("Export failed - see the output/console for details.", THEME.warn)
			notify("Export failed - see output", "err")
			setProgress(nil)
		end
		finalizing = false
		recBtn.setEnabled(true)
		recBtn.setText("START RECORDING")
		setSubtitle("v9 - ready")
		setActionsEnabled(lastSession ~= nil, lastReport ~= nil)
		if ok and CONFIG.AutoReplay then
			task.wait(0.4)
			pcall(PB.replay, true)
		end
	end)
end

recBtn.onClick(function()
	if finalizing then return end
	if recording then stopRecording() else startRecording() end
end)

