function MODES.find(text)
	local q = text:lower()
	local function score(n)
		n = n:lower()
		if n == q then return 3 end
		if n:sub(1, #q) == q then return 2 end
		if n:find(q, 1, true) then return 1 end
		return 0
	end
	local best, bestScore = nil, 0
	for _, plr in ipairs(Players:GetPlayers()) do
		local ch = plr.Character
		if ch then
			local sc = math.max(score(plr.Name), score(plr.DisplayName))
			if sc > bestScore then best, bestScore = ch, sc end
		end
	end
	if bestScore < 3 then
		local list = Workspace:GetDescendants()
		for i = 1, #list do
			local d = list[i]
			if d:IsA("Model") and d.Name ~= "R6TestClone" and d:FindFirstChildOfClass("Humanoid") then
				local sc = score(d.Name)
				if sc > bestScore then best, bestScore = d, sc end
			end
		end
	end
	if not best then return nil, "Victim not found: " .. text end
	local hum = best:FindFirstChildOfClass("Humanoid")
	if not (hum and hum.RigType == Enum.HumanoidRigType.R6 and best:FindFirstChild("Torso") and best:FindFirstChild("HumanoidRootPart")) then
		return nil, best.Name .. " is not an R6 rig"
	end
	return best
end

