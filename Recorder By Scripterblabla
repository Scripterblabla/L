		local ok = pcall(function()
			local okG, getAsset = pcall(function() return getcustomasset or getsynasset or (getgenv and getgenv().getcustomasset) end)
			if not (okG and type(getAsset) == "function" and writeFile and makeFolder) then error("no custom asset support") end

			local chars = "ABCDEFGHIJKLMNOPQRSTUVWXYZabcdefghijklmnopqrstuvwxyz0123456789+/"
			local map = {}
			for i = 1, 64 do map[chars:byte(i)] = i - 1 end
			local out, n, buf, bits = {}, 0, 0, 0
			for i = 1, #LOGO_B64 do
				local v = map[LOGO_B64:byte(i)]
				if v then
					buf = buf * 64 + v
					bits += 6
					if bits >= 8 then
						bits -= 8
						local p = 2 ^ bits
						n += 1
						out[n] = string.char(math.floor(buf / p))
						buf = buf % p
					end
				end
				if i % 20000 == 0 then task.wait() end
			end
			local bytes = table.concat(out)
			pcall(makeFolder, CONFIG.FolderName)
			local path = CONFIG.FolderName .. "/logo.png"
			writeFile(path, bytes)
			local asset = getAsset(path)
			if type(asset) ~= "string" or asset == "" then error("no asset") end
			logoImg.Image = asset
		end)
