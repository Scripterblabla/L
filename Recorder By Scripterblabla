local function rnd(n)
	if n ~= n or n == math.huge or n == -math.huge then return 0 end
	return math.round(n * 10000) / 10000
end

local function cfArr(cf)
	local t = { cf:GetComponents() }
	for i, v in ipairs(t) do t[i] = rnd(v) end
	return t
end

local function ser(v)
	local tv = typeof(v)
	if tv == "number" then return rnd(v)
	elseif tv == "string" or tv == "boolean" then return v
	elseif tv == "Vector3" then return { rnd(v.X), rnd(v.Y), rnd(v.Z) }
	elseif tv == "Vector2" then return { rnd(v.X), rnd(v.Y) }
	elseif tv == "Color3" then return "#" .. v:ToHex()
	elseif tv == "CFrame" then return cfArr(v)
	elseif tv == "NumberRange" then return { rnd(v.Min), rnd(v.Max) }
	elseif tv == "NumberSequence" then
		local out = {}
		for _, k in ipairs(v.Keypoints) do table.insert(out, { rnd(k.Time), rnd(k.Value), rnd(k.Envelope) }) end
		return out
	elseif tv == "ColorSequence" then
		local out = {}
		for _, k in ipairs(v.Keypoints) do table.insert(out, { rnd(k.Time), "#" .. k.Value:ToHex() }) end
		return out
	elseif tv == "EnumItem" then return tostring(v)
	elseif tv == "Instance" then return v:GetFullName()
	elseif tv == "Content" then
		local ok, uri = pcall(function() return v.Uri end)
		return (ok and uri) or tostring(v)
	end
	return tostring(v)
end

