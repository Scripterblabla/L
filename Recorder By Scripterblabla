local function newBuf()
	local b = { n = 0, parts = {} }
	function b.add(s)
		b.n += 1
		b.parts[b.n] = s
		if b.n % 40 == 0 then slice() end
	end
	function b.text() return table.concat(b.parts, "\n") end
	return b
end

local function fitText(text, limit, note)
	if #text <= limit then return text, false end
	local cut = text:sub(1, limit)
	local upTo = cut:match("^(.*)\n")
	if upTo and #upTo > limit * 0.5 then cut = upTo end
	return cut .. "\n" .. (note or "...(cut for size - the full version is saved on disk in the session folder)"), true
end

local function paginate(text, size)
	local pages = {}
	local pos, len = 1, #text
	while pos <= len do
		local stop = math.min(pos + size - 1, len)
		if stop < len then
			local chunk = text:sub(pos, stop)
			local lastNl = chunk:match("^.*()\n")
			if lastNl and lastNl > size * 0.4 then stop = pos + lastNl - 1 end
		end
		pages[#pages + 1] = text:sub(pos, stop)
		pos = stop + 1
	end
	if #pages == 0 then pages[1] = "" end
	return pages
end

local function storeLongString(parent, baseName, str)
	local n = 0
	for i = 1, #str, CONFIG.StringChunk do
		n += 1
		local sv = Instance.new("StringValue")
		sv.Name = ("%s_%02d"):format(baseName, n)
		sv.Value = str:sub(i, i + CONFIG.StringChunk - 1)
		sv.Parent = parent
		if n % CONFIG.StringChunkYield == 0 then slice() end
	end
	return n
end

local function dexJson(str, fileName)
	if #str <= CONFIG.DexStringLimit then return str end
	return ("TOO LARGE FOR DEX (%s chars). Open the saved file instead: workspace/%s/<session>/%s"):format(
		formatNum(#str), CONFIG.FolderName, fileName)
end

local function encodeArray(list, chunkSize, map)
	local parts = {}
	local n = #list
	local i = 1
	while i <= n do
		local chunk = {}
		for j = i, math.min(i + chunkSize - 1, n) do
			chunk[#chunk + 1] = map and map(list[j]) or list[j]
		end
		local s = safeEncode(chunk)
		if #s > 2 then parts[#parts + 1] = s:sub(2, -2) end
		i += chunkSize
		slice()
	end
	return "[" .. table.concat(parts, ",") .. "]"
end

local function jsonWithArrays(head, arrays)
	local base = safeEncode(head)
	local body = base:sub(2, -2)
	local pieces = {}
	if body ~= "" then pieces[1] = body end
	for _, a in ipairs(arrays) do
		pieces[#pieces + 1] = '"' .. a[1] .. '":' .. a[2]
	end
	return "{" .. table.concat(pieces, ",") .. "}"
end

local function fitAttrJson(list, limit)
	local n = math.min(#list, 2000)
	local out = list
	if n < #list then out = table.move(list, 1, n, 1, {}) end
	local s = safeEncode(out)
	while #s > limit and n > 1 do
		n = math.floor(n * 0.7)
		out = table.move(list, 1, n, 1, {})
		s = safeEncode(out)
		slice()
	end
	return s
end

local function relPath(inst, anc)
	local t = {}
	local c = inst
	while c and c ~= anc do
		table.insert(t, 1, c.Name)
		c = c.Parent
	end
	return t
end

