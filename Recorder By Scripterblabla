			if type(g.syn) == "table" and type(g.syn.write_clipboard) == "function" then
				setClipboard = g.syn.write_clipboard
			elseif type(g.Clipboard) == "table" and type(g.Clipboard.set) == "function" then
				setClipboard = g.Clipboard.set
			end
		end
	end
	writeFile = envFn("writefile") or (type(writefile) == "function" and writefile) or nil
	makeFolder = envFn("makefolder") or (type(makefolder) == "function" and makefolder) or nil
