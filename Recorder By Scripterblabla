local function cleanup()
	recording = false
	for _, c in ipairs(conns) do pcall(function() c:Disconnect() end) end
	table.clear(conns)
	for _, c in ipairs(gconns) do pcall(function() c:Disconnect() end) end
	table.clear(gconns)
	for _, c in ipairs(UI.conns) do pcall(function() c:Disconnect() end) end
	table.clear(UI.conns)
	pcall(PB.stopCamera)
	pcall(PB.stopVFX)
	pcall(function()
		local s = sharedEnv.R6RecorderEmit
		if type(s) == "table" then s.handler = nil end
	end)
	if testClone then pcall(function() testClone:Destroy() end) end
	setPulse(false)
	if UI.screenGui then UI.screenGui:Destroy() end
	sharedEnv.R6RecorderCleanup = nil
end
sharedEnv.R6RecorderCleanup = cleanup

