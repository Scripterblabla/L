	local lastPushT, lastVals = 0, { 0, 0, 0, 0 }
	local function resetHeat()
		lastPushT = 0
		lastVals = { 0, 0, 0, 0 }
		for r = 1, ROWS do
			for c = 1, COLS do
				hist[r][c] = 0
				cells[r][c].BackgroundColor3 = LEVEL[1]
			end
			rateLabels[r].Text = "+0/s"
		end
	end

	local function pushHeat(t, vals)
		local dt = t - lastPushT
		if t < lastPushT then
			lastPushT = 0
			return
		end
		if dt < 0.5 then return end
		lastPushT = t
		for r = 1, ROWS do
			local delta = math.max(0, vals[r] - lastVals[r])
			lastVals[r] = vals[r]
			local rate = delta / dt
			local v
			if r <= 2 then
				v = math.sqrt(math.clamp(rate / 70, 0, 1))
			else
				v = delta > 0 and math.clamp(0.5 + delta * 0.15, 0, 1) or 0
			end
			local row = hist[r]
			for c = 1, COLS - 1 do row[c] = row[c + 1] end
			row[COLS] = v
			for c = 1, COLS do
				tween(cells[r][c], { BackgroundColor3 = levelColor(row[c]) }, 0.3)
			end
			rateLabels[r].Text = ("+%s/s"):format(rate >= 10 and tostring(math.floor(rate + 0.5)) or ("%.1f"):format(rate))
		end
	end

