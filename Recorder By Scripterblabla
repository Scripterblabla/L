	local function nameLooksRelevant(name)
		local lower = name:lower()
		for _, h in ipairs(MODULE_HINTS) do
			if lower:find(h, 1, true) then return true end
		end
		return false
	end

	local function scanDependencies(ownFolder)
		local out = {}
		local function consider(d, label, filterFn)
			if d:IsA("LuaSourceContainer") and filterFn(d) then
				out[#out + 1] = ("  %s: %s (%s)"):format(label, d:GetFullName(), d.ClassName)
			end
		end
		local function scan(container, label, filterFn)
			if not container or #out >= 60 then return end
			consider(container, label, filterFn)
			local list = container:GetDescendants()
			for i = 1, #list do
				if #out >= 60 then return end
				consider(list[i], label, filterFn)
				if i % 150 == 0 then slice() end
			end
		end
		scan(character, "character script", function(d) return d.Name ~= "Animate" and d.Name ~= "Health" end)
		scan(player:FindFirstChild("PlayerScripts"), "player script", function(d)
			return d:GetFullName():find("PlayerModule", 1, true) == nil and d.Name ~= "RbxCharacterSounds"
		end)
		local moduleFilter = function(d) return d:IsA("ModuleScript") and nameLooksRelevant(d.Name) end
		for _, child in ipairs(ReplicatedStorage:GetChildren()) do
			if child ~= ownFolder then scan(child, "possibly related module", moduleFilter) end
		end
		scan(ReplicatedFirst, "possibly related module", moduleFilter)
		return out
	end

