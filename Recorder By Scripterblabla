	local JOINT_NAMES = { "Torso", "Head", "Left Arm", "Right Arm", "Left Leg", "Right Leg" }

	local function numStr(x)
		local s = ("%.3f"):format(x)
		s = s:gsub("0+$", ""):gsub("%.$", "")
		if s == "-0" or s == "" then s = "0" end
		return s
	end

	local function cfCode(cf)
		local rx, ry, rz = cf:ToOrientation()
		local p = cf.Position
		local rot = ("%s,%s,%s"):format(numStr(math.deg(rx)), numStr(math.deg(ry)), numStr(math.deg(rz)))
		if p.Magnitude < 0.002 then
			return "R(" .. rot .. ")"
		end
		return ("PR(%s,%s,%s,%s)"):format(numStr(p.X), numStr(p.Y), numStr(p.Z), rot)
	end

	local function frameError(fr, a, b, i)
		local fa, fb, fi = fr[a], fr[b], fr[i]
		local alpha = (fi.t - fa.t) / math.max(fb.t - fa.t, 1e-6)
		local worst = 0
		for _, name in ipairs(JOINT_NAMES) do
			local ca, cb, ci = fa.poses[name], fb.poses[name], fi.poses[name]
			if ca and cb and ci then
				local interp = ca:Lerp(cb, alpha)
				local posErr = (interp.Position - ci.Position).Magnitude
				local _, angle = interp:ToObjectSpace(ci):ToAxisAngle()
				worst = math.max(worst, posErr + math.abs(angle))
			end
		end
		return worst
	end

	local function reduceKeyframes(fr, tol, maxKeep)
		local n = #fr
		local order, errs = { 1 }, { math.huge }
		if n < 2 then return order, errs, 0 end
		order[2], errs[2] = n, math.huge

		local segs = {}
		local function makeSeg(a, b)
			if b - a < 2 then return end
			local worst, idx = 0, nil
			for i = a + 1, b - 1 do
				local e = frameError(fr, a, b, i)
				if e > worst or not idx then worst, idx = e, i end
				slice()
			end
			if idx then segs[#segs + 1] = { a = a, b = b, err = worst, idx = idx } end
		end

		makeSeg(1, n)
		while #segs > 0 and #order < maxKeep do
			local bi = 1
			for i = 2, #segs do
				if segs[i].err > segs[bi].err then bi = i end
			end
			local s = table.remove(segs, bi)
			if s.err <= tol then
				table.insert(segs, s)
				break
			end
			order[#order + 1] = s.idx
			errs[#errs + 1] = s.err
			makeSeg(s.a, s.idx)
			makeSeg(s.idx, s.b)
		end

		local residual = 0
		for _, s in ipairs(segs) do residual = math.max(residual, s.err) end
		return order, errs, residual
	end

