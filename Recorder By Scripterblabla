local CAP = (function()
	local C = {}
	C.emitHook = false

	local function addAsset(raw, kind, label)
		if type(raw) ~= "string" or raw == "" then return end
		local a = assets[raw]
		if not a then
			a = { kind = kind, users = {}, userList = {} }
			assets[raw] = a
			table.insert(assetOrder, raw)
		end
		if not a.users[label] then
			a.users[label] = true
			table.insert(a.userList, label)
		end
	end

	local function collectAssets(propTable, className, label, list)
		for k, v in pairs(propTable) do
			if ASSET_PROPS[k] and type(v) == "string" and v ~= "" then
				addAsset(v, className .. "." .. k, label)
				if list and not table.find(list, v) then table.insert(list, v) end
			end
		end
	end

	local function logEvent(rec, t, kind, detail)
		if #rec.events >= CONFIG.MaxEventsPerVFX then return end
		rec.events[#rec.events + 1] = { t = rnd(t), kind = kind, detail = detail or "" }
		local line = ("%.2fs #%d %s %s"):format(t, rec.id, kind, rec.name)
		recent[#recent + 1] = line
		if #recent > 2 then table.remove(recent, 1) end
		refreshHud(false)
	end

	local function belongsToOtherPlayer(inst)
		local model = inst:FindFirstAncestorOfClass("Model")
		while model do
			local plr = Players:GetPlayerFromCharacter(model)
			if plr and plr ~= player then return true end
			model = model:FindFirstAncestorOfClass("Model")
		end
		return false
	end

	local modelCapNotified = false
	local modelCursor = 1

	local function insideTrackedModel(inst)
		local a = inst.Parent
		while a and a ~= Workspace do
			if modelByInst[a] then return true end
			a = a.Parent
		end
		return false
	end

	local function insideReplay(inst)
		local a = inst
		while a and a ~= Workspace do
			if a.Name == "R6VFXReplay" or a.Name == "R6TestClone" then return true end
			a = a.Parent
		end
		return false
	end

	local function hasModelAncestor(inst)
		local a = inst.Parent
		while a and a ~= Workspace do
			if a:IsA("Model") or a:IsA("Tool") or a:IsA("Accessory") then return true end
			a = a.Parent
		end
		return false
	end

	local function modelPos(inst)
		local ok, cf = pcall(function() return inst:GetPivot() end)
		if ok and cf then return cf.Position end
		return nil
	end

	local function modelAllowed(inst, root)
		if modelByInst[inst] or #modelList >= CONFIG.MaxModels then return false end
		if inst:IsA("Terrain") then return false end
		if inst == character or inst:IsDescendantOf(character) then return false end
		if not inst:IsDescendantOf(Workspace) then return false end
		local cam = Workspace.CurrentCamera
		if cam and inst:IsDescendantOf(cam) then return false end
		if insideReplay(inst) or insideTrackedModel(inst) then return false end
		if not inst:IsA("BasePart") and not CONFIG.IncludeHumanoidModels and inst:FindFirstChildOfClass("Humanoid") then
			return false
		end
		if not CONFIG.IncludeOtherPlayers and belongsToOtherPlayer(inst) then return false end
		local pos = modelPos(inst)
		return pos ~= nil and (pos - root.Position).Magnitude <= CONFIG.ModelRadius
	end

	local function looseAllowed(inst)
		if not CONFIG.RecordLooseParts or not inst:IsA("BasePart") then return false end
		if inst.Transparency >= 1 and #inst:GetChildren() == 0 then return false end
		if inst:FindFirstAncestorOfClass("Tool") or inst:FindFirstAncestorOfClass("Accessory") then return false end
		return not hasModelAncestor(inst)
	end

	local function logModelEvent(rec, t, kind, detail)
		rec.events[#rec.events + 1] = { t = rnd(t), kind = kind, detail = detail or "" }
		local line = ("%.2fs M#%d %s %s"):format(t, rec.id, kind, rec.name)
		recent[#recent + 1] = line
		if #recent > 2 then table.remove(recent, 1) end
		refreshHud(false)
	end

	local function makeModelClone(rec)
		local inst = rec.inst
		local prev = inst.Archivable
		pcall(function() inst.Archivable = true end)
		for _, d in ipairs(inst:GetDescendants()) do
			pcall(function() d.Archivable = true end)
		end
		local ok, c = pcall(function() return inst:Clone() end)
		pcall(function() inst.Archivable = prev end)
		if not ok or not c then return nil end
		for _, d in ipairs(c:GetDescendants()) do
			if d:IsA("BaseScript") then
				d:Destroy()
			elseif d:IsA("Sound") then
				d.Playing = false
			end
		end
		if c:IsA("BasePart") then c.Anchored = true end
		c.Name = ("MODEL%03d_%s_%s"):format(rec.id, rec.class, rec.name)
		return c
	end

	local function collectModelAssets(rec)
		local label = ("M#%d %s"):format(rec.id, rec.name)
		local function scan(d)
			if d:IsA("BasePart") then
				collectAssets(readProps(d, { "MeshId", "TextureID" }), d.ClassName, label, rec.assetIds)
			else
				local list = CHILD_PROPS[d.ClassName]
				if list then collectAssets(readProps(d, list), d.ClassName, label, rec.assetIds) end
			end
			if d:IsA("LuaSourceContainer") then
				scriptsFound[#scriptsFound + 1] = { model = rec.id, name = d.Name, class = d.ClassName, path = d:GetFullName() }
			end
		end
		scan(rec.inst)
		local list = rec.inst:GetDescendants()
		for i = 1, math.min(#list, 3000) do scan(list[i]) end
	end

	local function registerModel(inst, t, baseline, root)
		if modelByInst[inst] then return false end
		if #modelList >= CONFIG.MaxModels then
			if not modelCapNotified then
				modelCapNotified = true
				notify(("Model limit reached (%d) - raise CONFIG.MaxModels if you need more"):format(CONFIG.MaxModels), "warn")
			end
			return false
		end
		local isPart = inst:IsA("BasePart")
		local partsList = {}
		if isPart then
			partsList[1] = inst
		else
			for _, d in ipairs(inst:GetDescendants()) do
				if d:IsA("BasePart") then
					partsList[#partsList + 1] = d
					if #partsList > CONFIG.MaxModelParts then return false end
				end
			end
		end
		if #partsList == 0 then return false end
		local ref = isPart and inst or inst.PrimaryPart or partsList[1]

		local rec = {
			id = #modelList + 1, inst = inst, ref = ref, class = inst.ClassName, name = inst.Name, isPart = isPart,
			origin = baseline and "present_at_start" or "spawned", path = inst:GetFullName(), start = t,
			events = {}, samples = {}, subs = {}, assetIds = {}, partCount = #partsList,
			host = { label = "world", parent = inst.Parent and inst.Parent:GetFullName() or "nil" },
			refPath = relPath(ref, inst),
		}
		local okS, sz = pcall(function()
			if isPart then return inst.Size end
			return inst:GetExtentsSize()
		end)
		rec.size = okS and sz or Vector3.new()
		rec.label = ("M#%d %s"):format(rec.id, rec.name)
		modelByInst[inst] = rec
		table.insert(modelList, rec)

		local refCF = ref.CFrame
		local rel0 = root.CFrame:ToObjectSpace(refCF)
		rec.lastRel = rel0
		rec.rel0 = rel0
		rec.samples[1] = { t = t, cf = rel0, w = refCF }

		for i = 1, math.min(#partsList, CONFIG.ModelSubParts) do
			local part = partsList[i]
			local rel = refCF:ToObjectSpace(part.CFrame)
			local size, tr, col = part.Size, part.Transparency, part.Color
			local sub = {
				inst = part, name = part.Name, path = relPath(part, inst),
				last = { rel = rel, size = size, tr = tr, col = col },
				samples = { { t = t, cf = rel, size = size, tr = tr, col = col } },
			}
			rec.subs[#rec.subs + 1] = sub
		end

		rec.clone = makeModelClone(rec)
		collectModelAssets(rec)

		for _, vr in ipairs(vfxList) do
			if not vr.hostRecId and not vr.hostModelId and vr.inst ~= inst and vr.inst:IsDescendantOf(inst) then
				vr.hostModelId = rec.id
				vr.hostPath = relPath(vr.inst, inst)
			end
		end

		logModelEvent(rec, t, baseline and "PRESENT_AT_START" or "APPEARED",
			("parts=%d size=%s"):format(rec.partCount, vec(rec.size)))

		table.insert(conns, inst.AncestryChanged:Connect(function()
			if recording and not rec.removed and not inst:IsDescendantOf(Workspace) then
				rec.removed = now()
				logModelEvent(rec, rec.removed, "REMOVED")
			end
		end))
		return true
	end

	function C.scanPresentModels(root)
		if not (REC.models and CONFIG.RecordModels and CONFIG.IncludePresentModels) or not root then return end
		local function walk(container, depth)
			for _, ch in ipairs(container:GetChildren()) do
				if #modelList >= CONFIG.MaxModels then return end
				if ch:IsA("Model") and not ch:IsA("Workspace") then
					if modelAllowed(ch, root) then registerModel(ch, 0, true, root) end
				elseif ch:IsA("Folder") and depth < 6 then
					walk(ch, depth + 1)
				end
			end
		end
		walk(Workspace, 0)
	end

	local function positionOf(inst)
		if inst:IsA("Explosion") then return inst.Position end
		local p = inst
		while p and p ~= Workspace do
			if p:IsA("BasePart") then return p.Position end
			if p:IsA("Attachment") then return p.WorldPosition end
			p = p.Parent
		end
		return nil
	end

	local function shouldTrack(inst, root)
		if vfxByInst[inst] then return false end
		local cat = CLASS_CATEGORY[inst.ClassName]
		if not cat then return false end
		if cat == "PostFX" then
			return inst.Parent == Lighting or inst.Parent == Workspace.CurrentCamera
		end
		if cat == "Sound" and DEFAULT_CHAR_SOUNDS[inst.Name] and inst.Parent and inst.Parent.Name == "HumanoidRootPart" then
			return false
		end
		if inst:IsDescendantOf(character) then return true end
		if not CONFIG.IncludeOtherPlayers and belongsToOtherPlayer(inst) then return false end
		local pos = positionOf(inst)
		if pos then return root ~= nil and (pos - root.Position).Magnitude <= CONFIG.VFXRadius end
		return cat == "Sound"
	end

	local function isEffectPart(inst, root)
		if not CONFIG.TrackEffectParts or vfxByInst[inst] or not inst:IsA("BasePart") or inst:IsA("Terrain") then return false end
		if inst:IsDescendantOf(character) then return false end
		if insideTrackedModel(inst) then return false end
		local model = inst:FindFirstAncestorOfClass("Model")
		if model and model:FindFirstChildOfClass("Humanoid") then return false end
		if (inst.Position - root.Position).Magnitude > CONFIG.VFXRadius then return false end
		return (not inst.CanCollide) or inst.Material == Enum.Material.Neon or inst.Material == Enum.Material.ForceField
			or inst.Transparency > 0
	end

	local function describeHost(inst)
		local host = { parent = inst.Parent and inst.Parent:GetFullName() or "nil" }
		local p = inst.Parent
		if p and p:IsA("Attachment") then
			host.attachment = p.Name
			host.attachmentCFrame = ser(p.CFrame)
			p = p.Parent
		end
		if p and p:IsA("BasePart") then
			host.part = p.Name
			host.onCharacter = p:IsDescendantOf(character)
		end
		if host.part then
			host.label = host.attachment and (host.part .. "/" .. host.attachment) or host.part
		else
			host.label = inst.Parent and inst.Parent.Name or "?"
		end
		return host
	end

	local function describeChildren(rec)
		local out = {}
		for _, d in ipairs(rec.inst:GetDescendants()) do
			local list = CHILD_PROPS[d.ClassName]
			if list then
				local entry = readProps(d, list)
				entry.Class = d.ClassName
				entry.Name = d.Name
				table.insert(out, entry)
				collectAssets(entry, d.ClassName, rec.label, rec.assetIds)
			end
		end
		return out
	end

	local function collectScripts(rec)
		local function check(d)
			if d:IsA("LuaSourceContainer") then
				table.insert(scriptsFound, { vfx = rec.id, name = d.Name, class = d.ClassName, path = d:GetFullName() })
			end
		end
		check(rec.inst)
		for _, d in ipairs(rec.inst:GetDescendants()) do check(d) end
	end

	local function makeClone(rec)
		local inst = rec.inst
		local prev = inst.Archivable
		inst.Archivable = true

		for _, d in ipairs(inst:GetDescendants()) do
			pcall(function() d.Archivable = true end)
		end
		local ok, c = pcall(function() return inst:Clone() end)
		inst.Archivable = prev
		if not ok or not c then return nil end
		for _, d in ipairs(c:GetDescendants()) do
			if d:IsA("BaseScript") then d:Destroy() end
		end
		if c:IsA("Sound") then c.Playing = false end
		for _, d in ipairs(c:GetDescendants()) do
			if d:IsA("Sound") then d.Playing = false end
		end
		if c:IsA("BasePart") then c.Anchored = true end
		c.Name = ("VFX%03d_%s_%s"):format(rec.id, rec.class, rec.name)
		return c
	end

	local function appearDetail(rec)
		local p = rec.props
		if rec.category == "EffectPart" then
			return ("size=%s material=%s transparency=%s"):format(safeEncode(p.Size or {}), tostring(p.Material), tostring(p.Transparency))
		elseif rec.class == "Sound" then
			return ("soundId=%s volume=%s"):format(tostring(p.SoundId), tostring(p.Volume))
		elseif p.Enabled ~= nil then
			return "enabled=" .. tostring(p.Enabled)
		end
		return ""
	end

	local pendingEmits = setmetatable({}, { __mode = "k" })
	local pendingCount = 0
	local lastWatch = 0
	local WATCH_SKIP = { Enabled = true, TimePosition = true, TimeLength = true, Playing = true, Position = true }

	local function keyOf(v)
		local tv = type(v)
		if tv == "number" or tv == "boolean" or tv == "string" then return v end
		return tostring(v)
	end

	local function setupWatch(rec)
		local list = PROPS[rec.class]
		if not list then return end
		local inst = rec.inst
		local watch, last = {}, {}
		for _, p in ipairs(list) do
			if not WATCH_SKIP[p] then
				local ok, v = pcall(function() return inst[p] end)
				if ok and v ~= nil and typeof(v) ~= "Instance" then
					watch[#watch + 1] = p
					last[p] = keyOf(v)
				end
			end
		end
		if #watch > 0 then
			rec.watch, rec.last = watch, last
			table.insert(watchRecs, rec)
		end
	end

	local function addEmit(rec, t, n)
		if #rec.emits >= CONFIG.MaxEmitsPerVFX then return end
		n = math.floor(tonumber(n) or 1)
		rec.emits[#rec.emits + 1] = { t = t, n = n }
		if #rec.emits <= 40 then logEvent(rec, t, "EMIT", ("count=%d"):format(n)) end
	end

	local function register(inst, t, baseline)
		if vfxByInst[inst] then return end
		if #vfxList >= CONFIG.MaxVFX then
			if not capNotified then
				capNotified = true
				notify(("VFX limit reached (%d) - raise CONFIG.MaxVFX if you need more"):format(CONFIG.MaxVFX), "warn")
			end
			return
		end
		local root = getRoot()
		local isPart = inst:IsA("BasePart")
		local rec = {
			id = #vfxList + 1,
			inst = inst,
			class = inst.ClassName,
			name = inst.Name,
			category = isPart and "EffectPart" or CLASS_CATEGORY[inst.ClassName],
			origin = baseline and "present_at_start" or "spawned",
			path = inst:GetFullName(),
			start = t,
			events = {},
			samples = {},
			dsamples = {},
			emits = {},
			assetIds = {},
		}
		rec.label = ("#%d %s"):format(rec.id, rec.name)
		vfxByInst[inst] = rec
		table.insert(vfxList, rec)

		rec.host = describeHost(inst)

		do
			local p = inst.Parent
			if p and p:IsA("Attachment") then
				rec.hostAttCF = p.CFrame
				p = p.Parent
			end
			if p and p:IsA("BasePart") and not rec.host.onCharacter and root then
				rec.hostRel = root.CFrame:ToObjectSpace(p.CFrame)
			end
			local anc = inst.Parent
			while anc and anc ~= Workspace do
				local hr = vfxByInst[anc]
				if hr then
					rec.hostRecId = hr.id
					rec.hostPath = relPath(inst, anc)
					break
				end
				local mr = modelByInst[anc]
				if mr then
					rec.hostModelId = mr.id
					rec.hostPath = relPath(inst, anc)
					break
				end
				anc = anc.Parent
			end
		end
		rec.props = readProps(inst, PROPS[inst.ClassName] or PART_PROPS)
		collectAssets(rec.props, rec.class, rec.label, rec.assetIds)
		collectScripts(rec)

		if isPart then
			effectPartCount += 1
			rec.children = describeChildren(rec)
			if root then
				local rel = root.CFrame:ToObjectSpace(inst.CFrame)
				rec.sampleLast = { rel = rel, size = inst.Size, tr = inst.Transparency, col = inst.Color }
				table.insert(rec.samples, { t = t, cf = rel, size = inst.Size, tr = inst.Transparency, col = inst.Color })
				rec.relCF = rel
			end
			table.insert(partRecs, rec)
		elseif rec.category == "PostFX" then
			table.insert(rec.samples, { t = t, v = readProps(inst, PROPS[rec.class]) })
			table.insert(fxRecs, rec)
		end
		if not isPart and rec.class ~= "Explosion" then setupWatch(rec) end

		if cloneCount < CONFIG.MaxClones then
			rec.clone = makeClone(rec)
			if rec.clone then cloneCount += 1 end
		end

		logEvent(rec, t, baseline and "PRESENT_AT_START" or "APPEARED", appearDetail(rec))

		local pend = pendingEmits[inst]
		if pend then
			pendingEmits[inst] = nil
			for _, e in ipairs(pend) do addEmit(rec, e.t, e.n) end
		end

		if rec.props.Enabled ~= nil then
			table.insert(conns, inst:GetPropertyChangedSignal("Enabled"):Connect(function()
				if recording then logEvent(rec, now(), inst.Enabled and "ENABLED" or "DISABLED") end
			end))
		end
		if rec.class == "Sound" then
			if inst.Playing then logEvent(rec, t, "SOUND_PLAY", ("timePos=%.2f"):format(inst.TimePosition)) end
			table.insert(conns, inst:GetPropertyChangedSignal("Playing"):Connect(function()
				if recording then
					logEvent(rec, now(), inst.Playing and "SOUND_PLAY" or "SOUND_STOP", ("timePos=%.2f"):format(inst.TimePosition))
				end
			end))
		end
		table.insert(conns, inst.AncestryChanged:Connect(function()
			if recording and not rec.removed and not inst:IsDescendantOf(game) then
				rec.removed = now()
				logEvent(rec, rec.removed, "REMOVED")
			end
		end))
	end

	local function tryRegister(inst, t, kind, root)
		if kind == "vfx" then
			if #vfxList < CONFIG.MaxVFX and shouldTrack(inst, root) then register(inst, t, false) end
		elseif kind == "model" then
			if modelAllowed(inst, root) then registerModel(inst, t, false, root) end
		else
			if #vfxList < CONFIG.MaxVFX and effectPartCount < CONFIG.MaxEffectParts and isEffectPart(inst, root) then
				register(inst, t, false)
			elseif CONFIG.RecordModels and not vfxByInst[inst] and looseAllowed(inst) and modelAllowed(inst, root) then
				registerModel(inst, t, false, root)
			end
		end
	end

	local function processQueue()
		if qHead > qTail then return end
		local root = getRoot()
		local stopAt = os.clock() + CONFIG.QueueBudget
		while qHead <= qTail do
			local item = queue[qHead]
			if item.due > os.clock() then break end
			queue[qHead] = nil
			qHead += 1
			local inst = item.inst
			if root and inst.Parent then
				local ok, err = pcall(tryRegister, inst, item.t, item.kind, root)
			end
			if os.clock() >= stopAt then break end
		end
		if qHead > qTail then qReset() end
	end

	local function onAdded(inst)
		if not recording then return end
		local kind
		if CLASS_CATEGORY[inst.ClassName] then
			if not REC.vfx or #vfxList >= CONFIG.MaxVFX then return end
			kind = "vfx"
		elseif inst:IsA("BasePart") then
			local effectOk = REC.vfx and CONFIG.TrackEffectParts and effectPartCount < CONFIG.MaxEffectParts and #vfxList < CONFIG.MaxVFX
			local looseOk = REC.models and CONFIG.RecordModels and CONFIG.RecordLooseParts and #modelList < CONFIG.MaxModels
			if not (effectOk or looseOk) then return end
			local root = getRoot()
			if not root or (inst.Position - root.Position).Magnitude > math.max(CONFIG.VFXRadius, CONFIG.ModelRadius) then return end
			kind = "part"
		elseif REC.models and CONFIG.RecordModels and inst:IsA("Model") and not inst:IsA("Workspace") and #modelList < CONFIG.MaxModels then
			kind = "model"
		else
			return
		end
		if qTail - qHead + 1 >= CONFIG.MaxPendingQueue then return end
		qTail += 1
		queue[qTail] = { inst = inst, t = now(), kind = kind, due = os.clock() + 0.03 }
	end

	local function solveTransform(desiredCF, motor)
		if not motor or not motor.Part0 then return CFrame.new() end
		return motor.C0:Inverse() * motor.Part0.CFrame:Inverse() * desiredCF * motor.C1
	end

	local function cfChanged(a, b, eps)
		if (a.Position - b.Position).Magnitude > eps then return true end
		return (a.LookVector - b.LookVector).Magnitude > eps or (a.UpVector - b.UpVector).Magnitude > eps
	end

	local function decimate(list)
		local out = {}
		for i = 1, #list, 2 do out[#out + 1] = list[i] end
		return out
	end

	local function recordPose(t)
		local src = REC.target or character
		if not src or not src.Parent then return end
		local root = src:FindFirstChild("HumanoidRootPart")
		local torso = src:FindFirstChild("Torso")
		if not root or not torso then return end

		local poses = { Torso = solveTransform(torso.CFrame, root:FindFirstChild("RootJoint")) }
		for _, data in ipairs(JOINTS) do
			local part = src:FindFirstChild(data.partName)
			local motor = torso:FindFirstChild(data.motorName)
			if part and motor then poses[data.partName] = solveTransform(part.CFrame, motor) end
		end
		frames[#frames + 1] = { t = t, poses = poses, root = startRootCF:ToObjectSpace(root.CFrame) }
		if #frames >= CONFIG.MaxFrames then
			frames = decimate(frames)
			frameStride *= 2
		end
	end

	local function pollTracks(t)
		local animator = humanoid:FindFirstChildOfClass("Animator")
		if not animator then return end
		local current = {}
		for _, track in ipairs(animator:GetPlayingAnimationTracks()) do
			current[track] = true
			if not activeTracks[track] then
				local id = track.Animation and track.Animation.AnimationId or ""
				local ev = {
					start = t, name = track.Name, id = id, priority = tostring(track.Priority),
					looped = track.Looped, length = track.Length, speed = track.Speed,
				}
				activeTracks[track] = ev
				table.insert(animEvents, ev)
			end
		end
		for track, ev in pairs(activeTracks) do
			if not current[track] then
				ev.stop = t
				activeTracks[track] = nil
			end
		end
	end

	local function pollOne(rec, t)
		local inst = rec.inst
		if rec.removed or not inst.Parent or #rec.dsamples >= CONFIG.MaxSamplesPerVFX then return end
		local watch, last = rec.watch, rec.last
		local changed
		for i = 1, #watch do
			local p = watch[i]
			local v = inst[p]
			local k = keyOf(v)
			if k ~= last[p] then
				last[p] = k
				changed = changed or {}
				changed[p] = v
			end
		end
		if changed then
			rec.dsamples[#rec.dsamples + 1] = { t = t, raw = changed }
			local sv = {}
			for p, v in pairs(changed) do sv[p] = ser(v) end
			rec.samples[#rec.samples + 1] = { t = t, v = sv }
		end
	end

	local function sampleModels(t, root, doSubs)
		local eps = CONFIG.SampleEpsilon
		local rootCF = root.CFrame
		for _, rec in ipairs(modelList) do
			local ref = rec.ref
			if not rec.removed and ref.Parent and #rec.samples < CONFIG.MaxModelSamples then
				local refCF = ref.CFrame
				local rel = rootCF:ToObjectSpace(refCF)
				if cfChanged(rel, rec.lastRel, eps) then
					rec.lastRel = rel
					rec.samples[#rec.samples + 1] = { t = t, cf = rel, w = refCF }
				end
			end
		end
		if not doSubs then return end
		local n = #modelList
		if n == 0 then return end
		local stopAt = os.clock() + CONFIG.ModelSampleBudget
		local count = 0
		while count < n do
			if modelCursor > n then modelCursor = 1 end
			local rec = modelList[modelCursor]
			modelCursor += 1
			count += 1
			local ref = rec.ref
			if not rec.removed and ref.Parent then
				local refCF = ref.CFrame
				for _, sub in ipairs(rec.subs) do
					local part = sub.inst
					if part.Parent and #sub.samples < CONFIG.MaxSubPartSamples then
						local rel = refCF:ToObjectSpace(part.CFrame)
						local size, tr, col = part.Size, part.Transparency, part.Color
						local last = sub.last
						if cfChanged(rel, last.rel, eps) or (size - last.size).Magnitude > eps
							or math.abs(tr - last.tr) > 0.005 or col ~= last.col then
							sub.last = { rel = rel, size = size, tr = tr, col = col }
							sub.samples[#sub.samples + 1] = { t = t, cf = rel, size = size, tr = tr, col = col }
						end
					end
				end
			end
			if os.clock() >= stopAt then break end
		end
	end

	local function sampleEffects(t)
		local root = getRoot()
		local eps = CONFIG.SampleEpsilon
		if root then
			for _, rec in ipairs(partRecs) do
				local part = rec.inst
				if not rec.removed and part.Parent and #rec.samples < CONFIG.MaxSamplesPerVFX then
					local rel = root.CFrame:ToObjectSpace(part.CFrame)
					local last = rec.sampleLast
					local size, tr, col = part.Size, part.Transparency, part.Color
					if not last or cfChanged(rel, last.rel, eps) or (size - last.size).Magnitude > eps
						or math.abs(tr - last.tr) > 0.005 or col ~= last.col then
						rec.sampleLast = { rel = rel, size = size, tr = tr, col = col }
						table.insert(rec.samples, { t = t, cf = rel, size = size, tr = tr, col = col })
					end
				end
			end
		end
		local c = os.clock()
		local doWatch = false
		if c - lastWatch >= CONFIG.WatchInterval then
			lastWatch = c
			doWatch = true
			for _, rec in ipairs(watchRecs) do pcall(pollOne, rec, t) end
		end
		if root and #modelList > 0 then
			local okM, errM = pcall(sampleModels, t, root, doWatch)
		end
	end

	function C.recordFrame()
		if not recording or not character or not character.Parent then return end
		if REC.vfx or REC.models then processQueue() end
		local t = now()
		if REC.pose then
			frameCounter += 1
			if frameCounter % frameStride == 0 then recordPose(t) end
		end
		if REC.tracks then pollTracks(t) end
		if REC.vfx or REC.models then sampleEffects(t) end
		refreshHud(false)
	end

	function C.recordCamera()
		if not recording or not REC.cam then return end
		local cam = Workspace.CurrentCamera
		local root = getRoot()
		if not cam or not root then return end
		camCounter += 1
		if camCounter % camStride ~= 0 then return end
		camSamples[#camSamples + 1] = {
			t = now(),
			cf = cam.CFrame,
			rel = root.CFrame:ToObjectSpace(cam.CFrame),
			fov = cam.FieldOfView,
		}
		if #camSamples >= CONFIG.MaxCamSamples then
			camSamples = decimate(camSamples)
			camStride *= 2
		end
	end

	local emitQueued = setmetatable({}, { __mode = "k" })

	local function handleEmit(self, count)
		if not recording or typeof(self) ~= "Instance" then return end
		local rec = vfxByInst[self]
		if rec then
			addEmit(rec, now(), count)
			return
		end
		if not self:IsA("ParticleEmitter") then return end
		local list = pendingEmits[self]
		if not list then
			if pendingCount >= 300 then return end
			pendingCount += 1
			list = {}
			pendingEmits[self] = list
		end
		if #list < 50 then list[#list + 1] = { t = now(), n = count } end
		if not emitQueued[self] then
			emitQueued[self] = true
			onAdded(self)
		end
	end

	local function installEmitHook()
		local state = sharedEnv.R6RecorderEmit
		if type(state) ~= "table" then
			state = {}
			local ok = pcall(function()
				local hook, getMethod = hookmetamethod, getnamecallmethod
				if type(hook) ~= "function" or type(getMethod) ~= "function" then error("unsupported") end
				local wrap = type(newcclosure) == "function" and newcclosure or function(f) return f end
				local old
				old = hook(game, "__namecall", wrap(function(self, ...)
					local h = state.handler
					if h and getMethod() == "Emit" then
						pcall(h, self, ...)
					end
					return old(self, ...)
				end))
			end)
			state.installed = ok
			sharedEnv.R6RecorderEmit = state
		end
		state.handler = handleEmit
		return state.installed == true
	end

	function C.reset()
		pendingEmits = setmetatable({}, { __mode = "k" })
		emitQueued = setmetatable({}, { __mode = "k" })
		pendingCount = 0
		lastWatch = 0
		modelCursor = 1
		modelCapNotified = false
	end

	function C.startHooks()
		C.emitHook = installEmitHook()
	end

	C.shouldTrack = shouldTrack
	C.register = register
	C.onAdded = onAdded
	return C
end)()

local VR = (function()
	local V = {}

	local function resolve(from, path)
		local cur = from
		for _, n in ipairs(path) do
			cur = cur and cur:FindFirstChild(n)
			if not cur then return nil end
		end
		return cur
	end

	function V.snapshot(length)
		local out = {}
		for _, rec in ipairs(vfxList) do
			if rec.clone then
				out[#out + 1] = {
					key = rec.id, id = rec.id, class = rec.class, name = rec.name, category = rec.category,
					start = rec.start, stop = rec.removed or length, ends = rec.removed ~= nil,
					template = rec.clone, host = rec.host, hostAttCF = rec.hostAttCF, hostRel = rec.hostRel,
					hostKey = rec.hostRecId or (rec.hostModelId and ("M" .. rec.hostModelId) or nil), hostPath = rec.hostPath,
					events = rec.events, emits = rec.emits,
					samples = rec.samples, dsamples = rec.dsamples, enabled0 = rec.props.Enabled,
				}
			end
		end
		return out
	end

	function V.snapshotModels(length)
		local out = {}
		for _, rec in ipairs(modelList) do
			if rec.clone and #rec.samples > 0 then
				local subs, strip = {}, false
				for _, s in ipairs(rec.subs) do
					if #s.samples > 0 then
						subs[#subs + 1] = { path = s.path, samples = s.samples }
						if #s.samples >= 2 then strip = true end
					end
				end
				out[#out + 1] = {
					key = "M" .. rec.id, id = rec.id, isModel = true, class = rec.class, name = rec.name, category = "Model",
					start = rec.start, stop = rec.removed or length, ends = rec.removed ~= nil,
					template = rec.clone, refPath = rec.refPath, samples = rec.samples, subs = subs,
					strip = strip, events = {}, emits = {}, dsamples = {},
				}
			end
		end
		return out
	end

	function V.play(model, session, wantVfx, wantModels)
		local vdata = wantVfx and session.vfx or {}
		local mdata = wantModels and session.models or {}
		local root = model:FindFirstChild("HumanoidRootPart")
		if (#vdata + #mdata) == 0 or not root then return nil end

		local rootCF = root.CFrame
		local length = session.length or 0
		local folder = Instance.new("Folder")
		folder.Name = "R6VFXReplay"
		folder.Parent = Workspace

		local states, byId = {}, {}
		for _, list in ipairs({ mdata, vdata }) do
			for _, d in ipairs(list) do
				local st = { d = d, ev = 1, em = 1, ds = 1, sm = 1 }
				states[#states + 1] = st
				byId[d.key] = st
			end
		end

		local function setProp(obj, p, v)
			pcall(function() obj[p] = v end)
		end

		local function makeHost(d)
			local h = d.host or {}
			if d.category == "PostFX" then
				if tostring(h.parent or ""):find("Camera", 1, true) and Workspace.CurrentCamera then
					return Workspace.CurrentCamera
				end
				return Lighting
			end
			if d.category == "EffectPart" then return folder end

			local part
			if h.onCharacter and h.part then
				part = model:FindFirstChild(h.part, true)
				if part and not part:IsA("BasePart") then part = nil end
			elseif d.hostRel then
				part = Instance.new("Part")
				part.Name = "VFXHost"
				part.Size = Vector3.new(0.2, 0.2, 0.2)
				part.Transparency = 1
				part.Anchored = true
				part.CanCollide = false
				part.CanQuery = false
				part.CanTouch = false
				part.CFrame = rootCF * d.hostRel
				part.Parent = folder
			end
			if not part then
				if d.category == "Sound" and not h.onCharacter then
					if h.parent == "SoundService" then return SoundService end
					return folder
				end
				part = root
			end
			if h.attachment then
				local att = part:FindFirstChild(h.attachment)
				if not (att and att:IsA("Attachment")) then
					att = Instance.new("Attachment")
					att.Name = h.attachment
					att.CFrame = d.hostAttCF or CFrame.new()
					att.Parent = part
				end
				return att
			end
			return part
		end

		local function spawnModel(st)
			local d = st.d
			local ok, c = pcall(function() return d.template:Clone() end)
			if not ok or not c then
				st.dead = true
				return false
			end
			c.Name = d.name
			if d.strip then

				for _, x in ipairs(c:GetDescendants()) do
					if x:IsA("JointInstance") or x:IsA("WeldConstraint") then pcall(function() x:Destroy() end) end
				end
			end
			local function lock(x)
				if x:IsA("BasePart") then
					x.Anchored = true
					x.CanCollide = false
					x.CanQuery = false
					x.CanTouch = false
				end
			end
			pcall(lock, c)
			for _, x in ipairs(c:GetDescendants()) do pcall(lock, x) end
			c.Parent = folder

			local ref = resolve(c, d.refPath)
			if not ref or not ref:IsA("BasePart") then
				pcall(function() c:Destroy() end)
				st.dead = true
				return false
			end
			st.obj, st.ref = c, ref
			st.subObjs, st.subCur = {}, {}
			for i, s in ipairs(d.subs) do
				local p = resolve(c, s.path)
				st.subObjs[i] = (p and p:IsA("BasePart")) and p or false
				st.subCur[i] = 1
			end
			return true
		end

		local function spawn(st)
			local d = st.d
			if d.isModel then return spawnModel(st) end
			if d.hostKey and byId[d.hostKey] then

				local ps = byId[d.hostKey]
				if ps.dead or ps.finished then
					st.dead = true
					return false
				end
				if not ps.obj then return false end
				local found
				if d.hostPath and #d.hostPath > 0 then
					found = resolve(ps.obj, d.hostPath)
				else
					found = ps.obj:FindFirstChild(d.name, true)
				end
				if not found then
					st.dead = true
					return false
				end
				if d.enabled0 ~= nil then setProp(found, "Enabled", d.enabled0) end
				st.obj = found
				st.bound = true
				return true
			end

			local ok, c = pcall(function() return d.template:Clone() end)
			if not ok or not c then
				st.dead = true
				return false
			end
			c.Name = d.name
			local okH, host = pcall(makeHost, d)
			if not okH or not host then
				c:Destroy()
				st.dead = true
				return false
			end
			if d.category == "EffectPart" then
				pcall(function()
					c.Anchored = true
					c.CanCollide = false
					c.CanQuery = false
					c.CanTouch = false
				end)
			end
			if d.enabled0 ~= nil then setProp(c, "Enabled", d.enabled0) end
			c.Parent = host
			st.obj = c
			return true
		end

		local function stepModel(st, t)
			local d = st.d
			local ref, obj = st.ref, st.obj
			if not ref or not ref.Parent then return end
			local sp = d.samples
			local n = #sp
			local i = st.sm
			while i < n and sp[i + 1].t <= t do i += 1 end
			st.sm = i
			local a, b = sp[i], sp[i + 1] or sp[i]
			local alpha = (b.t > a.t) and math.clamp((t - a.t) / (b.t - a.t), 0, 1) or 0
			local desired = rootCF * a.cf:Lerp(b.cf, alpha)
			obj:PivotTo((desired * ref.CFrame:Inverse()) * obj:GetPivot())

			for si, s in ipairs(d.subs) do
				local part = st.subObjs[si]
				if part and part.Parent then
					local ss = s.samples
					local m = #ss
					local c = st.subCur[si]
					while c < m and ss[c + 1].t <= t do c += 1 end
					st.subCur[si] = c
					local sa, sb = ss[c], ss[c + 1] or ss[c]
					local al = (sb.t > sa.t) and math.clamp((t - sa.t) / (sb.t - sa.t), 0, 1) or 0
					local sz = sa.size:Lerp(sb.size, al)
					if (part.Size - sz).Magnitude > 0.001 then part.Size = sz end
					part.Transparency = sa.tr + (sb.tr - sa.tr) * al
					part.Color = sa.col:Lerp(sb.col, al)
					part.CFrame = desired * sa.cf:Lerp(sb.cf, al)
				end
			end
		end

		local function step(st, t)
			local d = st.d
			if st.dead or st.finished then return end
			if not st.obj then
				if t < d.start then return end
				if not spawn(st) then return end
			end
			local obj = st.obj

			if d.ends and t >= d.stop then
				st.finished = true
				st.obj = nil
				pcall(function() obj:Destroy() end)
				return
			end

			if d.isModel then
				stepModel(st, t)
				return
			end

			local evs = d.events
			while st.ev <= #evs and evs[st.ev].t <= t do
				local k = evs[st.ev].kind
				st.ev += 1
				if k == "ENABLED" then
					setProp(obj, "Enabled", true)
				elseif k == "DISABLED" then
					setProp(obj, "Enabled", false)
				elseif k == "SOUND_PLAY" then
					pcall(function() obj:Play() end)
				elseif k == "SOUND_STOP" then
					pcall(function() obj:Stop() end)
				end
			end

			local ems = d.emits
			while st.em <= #ems and ems[st.em].t <= t do
				local e = ems[st.em]
				st.em += 1
				pcall(function() obj:Emit(e.n) end)
			end

			local ds = d.dsamples
			while st.ds <= #ds and ds[st.ds].t <= t do
				for p, v in pairs(ds[st.ds].raw) do setProp(obj, p, v) end
				st.ds += 1
			end

			if d.category == "EffectPart" and not st.bound then
				local sp = d.samples
				local n = #sp
				if n > 0 then
					local i = st.sm
					while i < n and sp[i + 1].t <= t do i += 1 end
					st.sm = i
					local a, b = sp[i], sp[i + 1] or sp[i]
					local alpha = (b.t > a.t) and math.clamp((t - a.t) / (b.t - a.t), 0, 1) or 0
					pcall(function()
						obj.CFrame = rootCF * a.cf:Lerp(b.cf, alpha)
						obj.Size = a.size:Lerp(b.size, alpha)
						obj.Transparency = a.tr + (b.tr - a.tr) * alpha
						if a.col and b.col then obj.Color = a.col:Lerp(b.col, alpha) end
					end)
				end
			end
		end

		local t0 = os.clock()
		local conn
		local playerObj = { Count = #states }

		function playerObj.Stop()
			if conn then
				conn:Disconnect()
				conn = nil
			end
			for _, st in ipairs(states) do

				if st.obj and not st.bound then pcall(function() st.obj:Destroy() end) end
				st.obj = nil
			end
			pcall(function() folder:Destroy() end)
		end

		conn = RunService.Heartbeat:Connect(function()
			local t = os.clock() - t0
			for _, st in ipairs(states) do
				local ok, err = pcall(step, st, t)
				if not ok then
					st.dead = true
				end
			end
			if t > length + 0.3 then playerObj.Stop() end
		end)

		return playerObj
	end

	return V
end)()

local PB = (function()
	local P = {}

	local EasingStyleMap = {
		[Enum.PoseEasingStyle.Linear] = Enum.EasingStyle.Linear,
		[Enum.PoseEasingStyle.Bounce] = Enum.EasingStyle.Bounce,
		[Enum.PoseEasingStyle.Cubic] = Enum.EasingStyle.Cubic,
		[Enum.PoseEasingStyle.Elastic] = Enum.EasingStyle.Elastic,
		[Enum.PoseEasingStyle.Constant] = Enum.EasingStyle.Linear,
	}

	local EasingDirectionMap = {
		[Enum.PoseEasingDirection.In] = Enum.EasingDirection.In,
		[Enum.PoseEasingDirection.Out] = Enum.EasingDirection.Out,
		[Enum.PoseEasingDirection.InOut] = Enum.EasingDirection.InOut,
	}

	local function PlayKeyframeSequence(Model, KeyframeSequence, SpeedMult)
		SpeedMult = SpeedMult or 1

		local kfs = {}
		for _, kf in ipairs(KeyframeSequence:GetKeyframes()) do
			table.insert(kfs, { Time = kf.Time, KF = kf })
		end
		table.sort(kfs, function(a, b) return a.Time < b.Time end)
		if #kfs == 0 then return nil end

		local motorMap = {}
		local function getMotor(poseName)
			if motorMap[poseName] then return motorMap[poseName] end
			for _, m in ipairs(Model:GetDescendants()) do
				if m:IsA("Motor6D") and m.Part1 and m.Part1.Name == poseName then
					motorMap[poseName] = m
					return m
				end
			end
			return nil
		end

		local jointData = {}
		for _, entry in ipairs(kfs) do
			for _, pose in ipairs(entry.KF:GetDescendants()) do
				if pose:IsA("Pose") and pose.Weight > 0 then
					local motor = getMotor(pose.Name)
					if motor then
						jointData[pose.Name] = jointData[pose.Name] or {}
						table.insert(jointData[pose.Name], {
							time = entry.Time, cframe = pose.CFrame,
							style = pose.EasingStyle, dir = pose.EasingDirection, motor = motor,
						})
					end
				end
			end
		end

		local animLen = kfs[#kfs].Time
		local hb = nil
		local startT = 0
		local cursors = {}
		local object = { Length = animLen / SpeedMult }

		function object.Stop()
			if hb then
				hb:Disconnect()
				hb = nil
			end
		end

		function object.Play()
			object.Stop()
			startT = os.clock()
			cursors = {}
			hb = RunService.Heartbeat:Connect(function()
				if not Model or not Model.Parent then
					object.Stop()
					return
				end
				local t = (os.clock() - startT) * SpeedMult
				if animLen > 0 then t = t % animLen end

				for name, poses in pairs(jointData) do

					local c = cursors[name] or 1
					if poses[c].time > t then c = 1 end
					while c < #poses and poses[c + 1].time <= t do c += 1 end
					cursors[name] = c

					local prev = poses[c]
					local nxt = poses[c + 1] or prev
					local alpha = (nxt.time > prev.time) and (t - prev.time) / (nxt.time - prev.time) or 0
					local eased = TweenService:GetValue(alpha,
						EasingStyleMap[nxt.style] or Enum.EasingStyle.Linear,
						EasingDirectionMap[nxt.dir] or Enum.EasingDirection.InOut)
					prev.motor.Transform = prev.cframe:Lerp(nxt.cframe, eased)
				end
			end)
		end

		return object
	end

	local camPlaybackConn, camRestore = nil, nil

	function P.stopCamera()
		if camRestore then camRestore() end
	end

	local currentVfx = nil
	function P.stopVFX()
		if currentVfx then
			pcall(currentVfx.Stop)
			currentVfx = nil
		end
	end

	local function playCamera(targetRoot, samples, speed)
		P.stopCamera()
		local cam = Workspace.CurrentCamera
		if not cam or #samples < 2 then return end
		speed = speed or 1
		local prevType, prevFov = cam.CameraType, cam.FieldOfView
		local length = samples[#samples].t
		local startT = os.clock()
		local idx = 1
		cam.CameraType = Enum.CameraType.Scriptable

		camRestore = function()
			if camPlaybackConn then
				camPlaybackConn:Disconnect()
				camPlaybackConn = nil
			end
			cam.CameraType = prevType
			cam.FieldOfView = prevFov
			camRestore = nil
		end

		camPlaybackConn = RunService.RenderStepped:Connect(function()
			local t = (os.clock() - startT) * speed
			if t >= length or not targetRoot.Parent then
				P.stopCamera()
				return
			end
			while idx < #samples - 1 and samples[idx + 1].t <= t do idx += 1 end
			local a, b = samples[idx], samples[idx + 1]
			local alpha = math.clamp((t - a.t) / math.max(b.t - a.t, 1e-4), 0, 1)
			cam.CFrame = targetRoot.CFrame * a.rel:Lerp(b.rel, alpha)
			cam.FieldOfView = a.fov + (b.fov - a.fov) * alpha
		end)
	end

	local function spawnTestClone(stripVfx)
		makeArchivable(character)
		local clone = character:Clone()
		if not clone then return nil end
		clone.Name = "R6TestClone"
		for _, d in ipairs(clone:GetDescendants()) do
			if d:IsA("BaseScript") or (stripVfx and CLASS_CATEGORY[d.ClassName]) then d:Destroy() end
		end
		local hum = clone:FindFirstChildOfClass("Humanoid")
		if hum then
			local animator = hum:FindFirstChildOfClass("Animator")
			if animator then animator:Destroy() end
			pcall(function() hum.EvaluateStateMachine = false end)
			hum.DisplayDistanceType = Enum.HumanoidDisplayDistanceType.None
		end
		local cloneRoot = clone:FindFirstChild("HumanoidRootPart")
		if cloneRoot then cloneRoot.Anchored = true end
		for _, m in ipairs(clone:GetDescendants()) do
			if m:IsA("Motor6D") then
				m.Enabled = true
				m.Transform = CFrame.new()
			end
		end
		clone.Parent = Workspace
		clone:PivotTo(character:GetPivot() * CFrame.new(8, 0, 0))
		return clone
	end

	function P.replay(quiet)
		if recording or finalizing then return end
		if not lastSession or not lastSession.ks or not lastSession.ks.Parent then
			notify("Nothing recorded yet - press START first.", "warn")
			return
		end
		P.stopCamera()
		P.stopVFX()
		if testClone then
			testClone:Destroy()
			testClone = nil
		end
		local wantVfx = CONFIG.ReplayVFX and lastSession.vfx ~= nil and #lastSession.vfx > 0
		local wantModels = CONFIG.RecordModels and lastSession.models ~= nil and #lastSession.models > 0
		local okClone, clone = pcall(spawnTestClone, wantVfx)
		if not okClone or not clone then
			notify("Could not create the test clone.", "err")
			return
		end
		testClone = clone
		local okPb, pb
		if lastSession.noFrames then
			okPb, pb = true, { Length = math.max(lastSession.length, 0.3), Play = function() end, Stop = function() end }
		else
			okPb, pb = pcall(PlayKeyframeSequence, clone, lastSession.ks, 1)
		end
		if not okPb or not pb then
			clone:Destroy()
			testClone = nil
			return
		end
		pb.Play()
		local cloneRoot = clone:FindFirstChild("HumanoidRootPart")
		if cloneRoot then playCamera(cloneRoot, lastSession.cam, 1) end
		local vfxPlayer = nil
		if wantVfx or wantModels then
			local okV, v = pcall(VR.play, clone, lastSession, wantVfx, wantModels)
			if okV and v then
				vfxPlayer = v
				currentVfx = v
			elseif not okV then
			end
		end
		setSubtitle(vfxPlayer and "Replaying + VFX/models..." or "Replaying...", THEME.accent)
		if quiet ~= true then
			setStatus(("Replaying on test clone (%.2fs)%s..."):format(pb.Length,
				vfxPlayer and (" + " .. vfxPlayer.Count .. " VFX/models") or ""))
		end
		task.delay(pb.Length + 0.5, function()
			pb.Stop()
			if vfxPlayer then
				pcall(vfxPlayer.Stop)
				if currentVfx == vfxPlayer then currentVfx = nil end
			end
			if testClone == clone then testClone = nil end
			if clone.Parent then clone:Destroy() end
			if not recording and not finalizing then
				setSubtitle("v9 - ready")
				if quiet ~= true then setStatus("Replay finished. Press R (or REPLAY) to replay again.") end
			end
		end)
	end

	return P
end)()

local EX = (function()
	local X = {}

	local function mapVfxSample(s)
		if s.cf then
			return { t = rnd(s.t), cf = cfArr(s.cf), size = ser(s.size), tr = rnd(s.tr), col = s.col and ser(s.col) or nil }
		end
		return { t = rnd(s.t), v = s.v }
	end

	local function mapEmit(e)
		return { t = rnd(e.t), n = e.n }
	end

	local function mapModelSample(s)
		return { t = rnd(s.t), cf = cfArr(s.cf), w = cfArr(s.w) }
	end

	local function buildVFXJson()
		local parts = {}
		for _, rec in ipairs(vfxList) do
			local scripts = {}
			for _, sc in ipairs(scriptsFound) do
				if sc.vfx == rec.id then table.insert(scripts, { name = sc.name, class = sc.class, path = sc.path }) end
			end
			local head = {
				id = rec.id, class = rec.class, name = rec.name, category = rec.category, origin = rec.origin,
				path = rec.path, host = rec.host, start = rnd(rec.start), removed = rec.removed and rnd(rec.removed) or nil,
				hostRecId = rec.hostRecId, hostModelId = rec.hostModelId, hostPath = rec.hostPath,
				events = rec.events, props = rec.props, children = rec.children, scripts = scripts,
			}
			parts[#parts + 1] = jsonWithArrays(head, {
				{ "samples", encodeArray(rec.samples, 100, mapVfxSample) },
				{ "emits", encodeArray(rec.emits, 200, mapEmit) },
			})
			slice()
		end
		return "[" .. table.concat(parts, ",") .. "]"
	end

	local function buildModelsJson()
		local parts = {}
		for _, rec in ipairs(modelList) do
			local scripts = {}
			for _, sc in ipairs(scriptsFound) do
				if sc.model == rec.id then table.insert(scripts, { name = sc.name, class = sc.class, path = sc.path }) end
			end
			local subJson = {}
			for _, sub in ipairs(rec.subs) do
				subJson[#subJson + 1] = jsonWithArrays({ name = sub.name, path = sub.path }, {
					{ "samples", encodeArray(sub.samples, 100, mapVfxSample) },
				})
			end
			local head = {
				id = rec.id, class = rec.class, name = rec.name, origin = rec.origin, path = rec.path,
				start = rnd(rec.start), removed = rec.removed and rnd(rec.removed) or nil,
				parts = rec.partCount, size = ser(rec.size), refPath = rec.refPath, events = rec.events,
				assets = rec.assetIds, scripts = scripts,
				note = "samples: cf = reference part CFrame relative to HumanoidRootPart, w = world CFrame. subParts samples: cf relative to the reference part (path = child names below the model).",
			}
			parts[#parts + 1] = jsonWithArrays(head, {
				{ "samples", encodeArray(rec.samples, 100, mapModelSample) },
				{ "subParts", "[" .. table.concat(subJson, ",") .. "]" },
