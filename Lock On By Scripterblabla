local target = nil
local lastAim = nil
local cam = workspace.CurrentCamera

local function myRoot()
	local c = lp.Character
	return c and c:FindFirstChild("HumanoidRootPart"), c and c:FindFirstChildOfClass("Humanoid")
end

local function validTarget(plr, hrp)
	if plr == lp then return nil end
	local c = plr.Character
	if not c then return nil end
	local h = c:FindFirstChildOfClass("Humanoid")
	local part = c:FindFirstChild(CFG.AimPart) or c:FindFirstChild("HumanoidRootPart")
	if not h or h.Health <= 0 or not part then return nil end
	local d = (part.Position - hrp.Position).Magnitude
	if d > CFG.Radius then return nil end
	return part, d
end

local function findNearest()
	local hrp = myRoot()
	if not hrp then return nil end
	local best, bestD
	for _, p in ipairs(Players:GetPlayers()) do
		local part, d = validTarget(p, hrp)
		if part and (not bestD or d < bestD) then
			best, bestD = p, d
		end
	end
	return best
end

local function setActive(on)
	active = on
	_G.__LockOnActive = on
	tween(stroke, 0.25, {Color = on and Color3.fromRGB(255, 255, 255) or CFG.Accent})
	tween(btn, 0.25, {BackgroundColor3 = on and Color3.fromRGB(20, 60, 80) or Color3.fromRGB(12, 18, 26)})
end

local function unlock()
	if target == nil and not active then return end
	target = nil
	setActive(false)
	hideCursor()
	local _, hum = myRoot()
	if hum then hum.AutoRotate = true end
end

local function lock()
	local p = findNearest()
	if not p then
		local base = btn.Position
		for i = 1, 4 do
			tween(btn, 0.04, {Position = base + UDim2.fromOffset(i % 2 == 0 and 5 or -5, 0)})
			task.wait(0.04)
		end
		tween(btn, 0.08, {Position = base})
		return
	end
	target = p
	lastAim = nil
	setActive(true)
	showCursor()
end

local BODY_BLOCK = {
	[Enum.HumanoidStateType.Physics] = true,
	[Enum.HumanoidStateType.Ragdoll] = true,
	[Enum.HumanoidStateType.FallingDown] = true,
	[Enum.HumanoidStateType.PlatformStanding] = true,
	[Enum.HumanoidStateType.Dead] = true,
}

local function getAim(plr)
	local c = plr.Character
	if c then
		local part = c:FindFirstChild(CFG.AimPart)
			or c:FindFirstChild("HumanoidRootPart")
			or c:FindFirstChild("UpperTorso")
			or c:FindFirstChild("Torso")
			or c:FindFirstChild("Head")
			or c.PrimaryPart
		if part then
			lastAim = part.Position
			return lastAim
		end
	end
	return lastAim
end

RunService:BindToRenderStep("LockOnStep", Enum.RenderPriority.Camera.Value + 1, function()
	if not target then return end
	if target.Parent ~= Players then
		unlock()
		return
	end
	cam = workspace.CurrentCamera
	if not cam then return end

	local aim = getAim(target)
	if not aim then return end

	local hrp, hum = myRoot()

	local want = CFrame.lookAt(cam.CFrame.Position, aim)
	cam.CFrame = cam.CFrame:Lerp(want, CFG.CamSmooth)

	if CFG.RotateChar and hrp and hum and hum.Health > 0 then
		local state = hum:GetState()
		if BODY_BLOCK[state] or hum.PlatformStand or hum.Sit then
			hum.AutoRotate = true
		else
			hum.AutoRotate = false
			local flat = Vector3.new(aim.X, hrp.Position.Y, aim.Z)
			if (flat - hrp.Position).Magnitude > 0.1 then
				hrp.CFrame = hrp.CFrame:Lerp(CFrame.lookAt(hrp.Position, flat), CFG.TurnSmooth)
			end
		end
	end

	local v, onScreen = cam:WorldToViewportPoint(aim)
	if onScreen and v.Z > 0 then
		cursor.Visible = true
		cursor.Position = UDim2.fromOffset(v.X, v.Y)
		local pulse = 1 + math.sin(os.clock() * 7) * 0.04
		local sz = CURSOR_SIZE * pulse
		cursor.Size = UDim2.fromOffset(sz, sz)
	else
		cursor.Visible = false
	end
end)

local dragging, dragInput, dragStart, startPos, moved = false, nil, nil, nil, false

btn.InputBegan:Connect(function(input)
	if input.UserInputType == Enum.UserInputType.Touch or input.UserInputType == Enum.UserInputType.MouseButton1 then
		dragging = true
		moved = false
		dragStart = input.Position
		startPos = root.AbsolutePosition + root.AbsoluteSize / 2
		dragInput = input
		tween(btn, 0.12, {Size = UDim2.fromOffset(S - 8, S - 8)})
	end
end)

UIS.InputChanged:Connect(function(input)
	if dragging and (input == dragInput or input.UserInputType == Enum.UserInputType.MouseMovement) then
		local delta = input.Position - dragStart
		if delta.Magnitude > 8 then moved = true end
		if moved then
			local vp = gui.AbsoluteSize
			local x = math.clamp(startPos.X + delta.X, 40, vp.X - 40)
			local y = math.clamp(startPos.Y + delta.Y, 40, vp.Y - 40)
			root.Position = UDim2.fromOffset(x, y)
		end
	end
end)

UIS.InputEnded:Connect(function(input)
	if dragging and (input == dragInput or input.UserInputType == Enum.UserInputType.MouseButton1) then
		dragging = false
		tween(btn, 0.25, {Size = UDim2.fromOffset(S, S)}, Enum.EasingStyle.Back)
		if not moved then
			if target then
				unlock()
			else
				lock()
			end
		end
	end
end)

root.Size = UDim2.fromOffset(0, 0)
tween(root, 0.45, {Size = UDim2.fromOffset(S + 20, S + 20)}, Enum.EasingStyle.Back)
