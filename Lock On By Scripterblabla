local cursorParts = {}
local cursorImage = loadAsset(CURSOR_FILE, CURSOR_B64)

if cursorImage then
	local img = Instance.new("ImageLabel")
	img.Size = UDim2.fromScale(1, 1)
	img.BackgroundTransparency = 1
	img.Image = cursorImage
	img.ImageColor3 = Color3.new(1, 1, 1)
	img.ScaleType = Enum.ScaleType.Fit
	img.Parent = cursor
	table.insert(cursorParts, img)
else
	local function line(x, y, w, h, ax, ay)
		local f = Instance.new("Frame")
		f.BorderSizePixel = 0
		f.BackgroundColor3 = Color3.new(1, 1, 1)
		f.AnchorPoint = Vector2.new(ax, ay)
		f.Position = UDim2.fromScale(x, y)
		f.Size = UDim2.fromOffset(w, h)
		f.Parent = cursor
		table.insert(cursorParts, f)
	end
	local L, T = 14, 2
	line(0, 0, L, T, 0, 0); line(0, 0, T, L, 0, 0)
	line(1, 0, L, T, 1, 0); line(1, 0, T, L, 1, 0)
	line(0, 1, L, T, 0, 1); line(0, 1, T, L, 0, 1)
	line(1, 1, L, T, 1, 1); line(1, 1, T, L, 1, 1)
	line(0.5, 0.5, 14, 1, 0.5, 0.5)
	line(0.5, 0.5, 1, 14, 0.5, 0.5)
end

local function setCursorAlpha(tr, t)
	for _, o in ipairs(cursorParts) do
		local prop = o:IsA("ImageLabel") and "ImageTransparency" or "BackgroundTransparency"
		if t then tween(o, t, {[prop] = tr}) else o[prop] = tr end
	end
end

local CURSOR_SIZE = 64
local function showCursor()
	cursor.Visible = true
	cursor.Size = UDim2.fromOffset(CURSOR_SIZE * 2.2, CURSOR_SIZE * 2.2)
	setCursorAlpha(1)
	setCursorAlpha(0, 0.25)
	tween(cursor, 0.3, {Size = UDim2.fromOffset(CURSOR_SIZE, CURSOR_SIZE)}, Enum.EasingStyle.Back)
end
local function hideCursor()
	setCursorAlpha(1, 0.15)
	tween(cursor, 0.18, {Size = UDim2.fromOffset(CURSOR_SIZE * 1.8, CURSOR_SIZE * 1.8)})
	task.delay(0.19, function() if not _G.__LockOnActive then cursor.Visible = false end end)
end

